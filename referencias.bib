@article{Paneva2018,
   abstract = {In this paper M/M/c queuing model is considered and applied to solve a problem in a supermarket when are generated crowds by buyers on the cash boxes. The model of the supermarket has three cash-settling boxes and one queue created from buyers. The performance of the supermarket is analyzed using three cash boxes with arriving rate of 50 customers/ hour and service rate 18 customers/ hour. Also, it is considered whether if is necessary to include additional cash boxes in order to reduce the waiting queue and time.},
   author = {Maja Kukuseva Paneva and Biljana Citkuseva Dimitrovska and Jasmina Veta Buralieva and Elena Karamazova and Tatjana Atanasova Pacemska},
   doi = {10.46763/BJAMI},
   issn = {2545-4803},
   issue = {1},
   journal = {Balkan Journal of Applied Mathematics and Informatics},
   keywords = {M/M/c queuing model,queuing models,supermarket,waiting lines},
   month = {8},
   pages = {73-78},
   title = {PROPOSED QUEUING MODEL M/M/3 WITH INFINITE WAITING LINE IN A SUPERMARKET},
   volume = {1},
   url = {https://js.ugd.edu.mk/index.php/bjami/article/view/2233},
   year = {2018}
}
@inproceedings{Liu2022,
   abstract = {The supermarket has the problems of low efficiency at the checkout counter, long waiting time in queue, and decreased customer satisfaction. Therefore, this paper finds that the arrival time of supermarket customers obeys Poisson distribution, and the service time obeys exponential distribution through queuing theory. By calculating the average arrival rate of customers, we can get the service intensity of the system in each period and master the use of the supermarket cashier system in each period. Finally, we use process analysis to shorten the cashier time, reduce customer waiting, optimize the number of cashiers according to the specific situation, and determine the optimal number of open cashiers in each period.},
   author = {Qun Liu and Hongxu Chen},
   city = {New York, NY, USA},
   doi = {10.1145/3535782.3535846},
   isbn = {9781450395816},
   booktitle = {Proceedings of the 4th International Conference on Management Science and Industrial Engineering},
   keywords = {Cashier forecast,Poisson distribution,goodness of fit test,queuing theory},
   month = {4},
   pages = {478-484},
   publisher = {ACM},
   title = {Optimization of J supermarket cashier service system based on M/M/c model},
   url = {https://dl.acm.org/doi/10.1145/3535782.3535846},
   year = {2022}
}
@inproceedings{Vilca-Cancho2025,
   abstract = {This article focuses on a convenience store located in Lima, Peru, which faces the challenge of long waiting lines that negatively impact service performance and customer perception, thereby compromising the quality of service for future clients. An observational, descriptive, and cross-sectional study with a quantitative and interventional approach was conducted to analyze customers' arrival, waiting, and service times in order to assign an appropriate probability distribution to describe their behavior using the Stat:Fit program. Additionally, to address this issue, ProModel simulation software and queuing theory were utilized to identify potential bottlenecks causing delays in customer service, with the aim of optimizing queue management. The results indicated that the addition of a third cashier reduces utilization from 86.21% to 58.864%. Furthermore, it is recommended to implement a self-service checkout or reorganize the product layout. These measures are intended to ensure satisfactory customer experience and improve operational efficiency in the convenience store.},
   author = {Jeanpierre Vilca-Cancho and Andersson Velásquez Cuci Ramos and Angie Diez Canseco-Mendoza and Mario Ninaquispe-Soto and Jairo R. Coronado-Hernández and Yasmina Riega-Virú and Eduardo Quezada-Hidalgo},
   doi = {10.1016/j.procs.2025.03.157},
   issn = {18770509},
   booktitle = {Procedia Computer Science},
   keywords = {Simulation,customer service,processes,queue management,waiting time},
   pages = {1178-1183},
   publisher = {Elsevier B.V.},
   title = {Enhancing Service Processes in a Convenience Store: Modelling and Simulation Approach in a in the Case of a Peruvian Store},
   volume = {257},
   year = {2025}
}
@article{Antczak2020,
   abstract = {We build a realistic agent-based model for simulating customer decisions of picking a checkout line at a supermarket that is calibrated to actual point of sale (POS) data from a major European retail chain. It is implemented on the open-access NetLogo simulation platform and is freely available to academics and practitioners interested in testing how different checkout zone layouts, as well as queue management and feedback strategies impact the overall efficiency of the checkout process. In particular, we show that when customers pick a line by minimizing the expected waiting time, not only is this choice beneficial for the customers themselves, as it leads to shorter waiting times in queues, but also for the supermarket management, since it yields shorter working times of the cashiers. As such, we provide guidance as to the feedback that could be provided to customers entering the checkout zone.},
   author = {Tomasz Antczak and Rafal Weron and Jacek Zabawa},
   doi = {10.1109/ACCESS.2020.3045919},
   issn = {2169-3536},
   journal = {IEEE Access},
   keywords = {Agent-based simulation,NetLogo,checkout process,customer analytics,decision support,queue management system,retail operations},
   pages = {228841-228852},
   publisher = {Institute of Electrical and Electronics Engineers Inc.},
   title = {Data-Driven Simulation Modeling of the Checkout Process in Supermarkets: Insights for Decision Support in Retail Operations},
   volume = {8},
   url = {https://ieeexplore.ieee.org/document/9300247/},
   year = {2020}
}
@article{Mazri2025,
   abstract = {<p>Queue management is a critical challenge for hypermarkets, where prolonged wait times can negatively impact customer satisfaction and operational efficiency. The congested checkout areas at Lotus Alor Setar are caused by a high number of customers and insufficient cashiers, resulting in slower transaction times for scanning, payments, and assistance. Such queuing problems cause delay to the overall service, thus reducing customer satisfaction. In response to the issue, this study aimed to enhance the queueing system at Lotus Alor Setar through a simulation model and to propose the most efficient hypermarket queueing system. Discrete Event Simulation was used to replicate the existing systems, followed by the testing of three scenarios to determine their respective performance in addressing the issue. The significance of this study lies in identifying ways to efficiently allocate resources, such as personnel and checkout stations, to promote cost savings and higher service quality. These findings offer useful insights not only for improving the queuing system at Lotus Alor Setar but also for guiding other hypermarkets alike.</p>},
   author = {Arief Farhan Mazri and Jack Kie Cheng and Yao Liu},
   doi = {10.15282/ijim.19.4.2025.11959},
   issn = {2590-3594},
   issue = {4},
   journal = {International Journal of Industrial Management},
   keywords = {Discrete event simulation,Hypermarket,Queueing system,Simulation,Waiting time},
   month = {12},
   pages = {197-209},
   publisher = {Universiti Malaysia Pahang Al-Sultan Abdullah Press (UMPSA Press)},
   title = {Application of Discrete Event Simulation for Enhancing Queuing System at Lotus Alor Setar},
   volume = {19},
   url = {https://journal.ump.edu.my/ijim/article/view/11959},
   year = {2025}
}
@techReport{Flavio2004,
   abstract = {In this study we analyze the congestion problem in Brazilian supermarket checkouts. We are particularly concerned with modeling the mean user waiting time in queue, viewed as an important component of the user service, as a function of the system capacity (i.e., the number of cashiers in a given time period). We present a simple Markovian model for the problem that considers instantaneous user jockeying among the queues with a fixed balk limit. In order to evaluate the performance of the model, we developed a case study in a unit of a Brazilian supermarket chain. The results of the model are also compared with the results obtained by representing the system as simple M/M/m and [M/M/1] m queueing models (where m is the number of cashiers). We show that the model can yield a good approximation to the problem, different from the other two, and it can be used to analyze the tradeoff between the number of cashiers and the mean user waiting time.},
   author = {Reinaldo Morabito Flavio and Costa Ribeiro De Lima},
   issue = {2},
   keywords = {Markovian Model,Queueing Theory,Supermarket Checkouts},
   pages = {165-177},
   title = {A Markovian Queueing Model for the Analysis of User Waiting Times in Supermarket Checkouts},
   volume = {10},
   year = {2004}
}
